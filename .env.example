# Nirikshan Platform Environment Variables
# Copy this file to .env and fill in actual secure values

# === Database Configuration ===
POSTGRES_DB=nirikshan
POSTGRES_USER=nirikshan_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_RANDOM_PASSWORD
POSTGRES_PORT=5432

# === Backend Configuration ===
DATABASE_URL=postgresql://nirikshan_user:CHANGE_THIS_SECURE_RANDOM_PASSWORD@localhost:5432/nirikshan

# JWT Security - CRITICAL: Generate a cryptographically secure random string (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=GENERATE_SECURE_64_CHAR_RANDOM_STRING_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# CORS - JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Environment (development/production)
ENV=development

# Backend port
BACKEND_PORT=8000

# ML Models path
ML_MODELS_PATH=../ml/models

# === Email Configuration (Optional) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Nirikshan Alerts <noreply@nirikshan.gov.in>

# === Production Environment Example ===
# For production, use:
# ENV=production
# CORS_ORIGINS=["https://nirikshan.gov.in","https://www.nirikshan.gov.in"]
# FRONTEND_URL=https://nirikshan.gov.in
# JWT_SECRET=<64+ char secure random string>
# POSTGRES_PASSWORD=<strong random password>
