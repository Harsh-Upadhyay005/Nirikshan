# Backend Configuration - Copy to .env and fill in actual values

# Database
DATABASE_URL=postgresql://nirikshan_user:YOUR_PASSWORD_HERE@localhost:5432/nirikshan

# JWT Security (CRITICAL: Generate a secure random string min 32 chars)
JWT_SECRET=GENERATE_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# ML Models
ML_MODELS_PATH=../ml/models

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Google OAuth (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Brevo Email (formerly SendinBlue) - For notifications
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@nirikshan.gov.in
BREVO_SENDER_NAME=Nirikshan Alerts

# Frontend
FRONTEND_URL=http://localhost:3000

# Environment
ENV=development

# Docker Compose variables (if using docker-compose)
POSTGRES_DB=nirikshan
POSTGRES_USER=nirikshan_user
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_PORT=5432
BACKEND_PORT=8000
